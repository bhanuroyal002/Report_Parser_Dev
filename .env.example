HOST=127.0.0.1
PORT=8080
DEBUG=false
DATABASE_PATH=data/gct_report_parser.db
MAX_FILE_SIZE_MB=500
MAX_REQUEST_SIZE_MB=1024
MAX_ZIP_DEPTH=20

# Secure Jenkins API access used to queue feedback notification emails.
# Create a dedicated Jenkins user/API token with permission to build only the feedback notification job.
JENKINS_URL=http://127.0.0.1:8081
JENKINS_FEEDBACK_JOB=Report_Parser_Feedback_Notification
JENKINS_USER=
JENKINS_API_TOKEN=
