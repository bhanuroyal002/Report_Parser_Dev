HOST=127.0.0.1
PORT=8080
DEBUG=false
DATABASE_PATH=data/gct_report_parser.db
MAX_FILE_SIZE_MB=500
MAX_REQUEST_SIZE_MB=1024
MAX_ZIP_DEPTH=20

# Feedback email notifications. Configure these on the server in /opt/report_parser/.env.
# Use the SMTP relay/settings approved for the Jenkins server; never commit real credentials.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
FEEDBACK_FROM_EMAIL=
FEEDBACK_TO_EMAILS=bhanuprakash.narla1@vantiva.com,bhanuprakash.narla@gmail.com
