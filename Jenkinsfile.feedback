pipeline {
    agent any

    options {
        timestamps()
        disableConcurrentBuilds()
        buildDiscarder(logRotator(numToKeepStr: '30'))
        timeout(time: 3, unit: 'MINUTES')
    }

    parameters {
        string(name: 'FEEDBACK_ID', defaultValue: '', description: 'Feedback record ID')
        string(name: 'SUBMITTED_AT', defaultValue: '', description: 'Submission timestamp (UTC)')
        string(name: 'FEEDBACK_NAME', defaultValue: 'Not provided', description: 'Submitter name')
        string(name: 'FEEDBACK_EMAIL', defaultValue: '', description: 'Submitter email; used as Reply-To')
        string(name: 'FEEDBACK_CATEGORY', defaultValue: 'General feedback', description: 'Feedback category')
        string(name: 'FEEDBACK_SUBJECT', defaultValue: 'New feedback', description: 'Feedback subject')
        text(name: 'FEEDBACK_MESSAGE', defaultValue: '', description: 'Feedback message')
    }

    stages {
        stage('Validate feedback') {
            steps {
                script {
                    if (!params.FEEDBACK_ID?.trim() ||
                        !params.FEEDBACK_EMAIL?.trim() ||
                        !params.FEEDBACK_EMAIL.contains('@') ||
                        !params.FEEDBACK_MESSAGE?.trim()) {
                        error('Required feedback notification parameters are missing or invalid.')
                    }
                }
            }
        }
        stage('Email administrators') {
            steps {
                script {
                    def safeSubject = (params.FEEDBACK_SUBJECT ?: 'New feedback')
                        .replaceAll(/[\\r\\n]+/, ' ')
                    def body = """A user submitted feedback to GCT Insight.

Feedback ID: ${params.FEEDBACK_ID}
Submitted at (UTC): ${params.SUBMITTED_AT}
Name: ${params.FEEDBACK_NAME}
Reply email: ${params.FEEDBACK_EMAIL}
Category: ${params.FEEDBACK_CATEGORY}
Subject: ${safeSubject}

Feedback message:
${params.FEEDBACK_MESSAGE}
"""
                    // Uses Jenkins' configured E-mail Notification settings via the Mailer plugin.
                    mail(
                        to: 'bhanuprakash.narla1@vantiva.com,bhanuprakash.narla@gmail.com',
                        replyTo: params.FEEDBACK_EMAIL,
                        subject: "[GCT Insight Feedback] ${params.FEEDBACK_CATEGORY}: ${safeSubject}",
                        body: body,
                        mimeType: 'text/plain'
                    )
                }
            }
        }
    }

    post {
        success {
            echo "Feedback notification email sent to the configured administrator recipients for feedback ID ${params.FEEDBACK_ID}."
        }
        failure {
            echo "Feedback notification failed for feedback ID ${params.FEEDBACK_ID}. Review Jenkins email configuration and console output."
        }
    }
}
